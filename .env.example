# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in the values.
#
#   cp .env.example .env.local
#
# .env.local is gitignored, so real keys never reach the repo. On a host
# (Vercel / Amplify / Railway) set the same names in the project's
# Environment Variables panel instead of shipping a file.
#
# NEXT_PUBLIC_* values are compiled into the browser bundle and are public.
# Everything else stays server-side. Never rename RESEND_API_KEY to
# NEXT_PUBLIC_RESEND_API_KEY — that would publish your mail key to visitors.
# ---------------------------------------------------------------------------

# Canonical site URL, no trailing slash.
# Drives canonical tags, the sitemap, Open Graph images and the structured data.
NEXT_PUBLIC_SITE_URL=https://www.kevinejiofor.com


# --- Contact form (server-side only) ---------------------------------------
# Both are required before /api/contact will deliver mail. Until they are set
# the form stays honest and tells visitors to email directly.
#
# 1. Create a key:            https://resend.com/api-keys
# 2. Verify your domain:      https://resend.com/domains
#    Resend gives you DNS records to add; sending fails until the domain shows
#    "Verified".
# 3. CONTACT_FROM_EMAIL must be on that verified domain. It is only the From
#    line, so it does not need to be a real inbox. Replies go to the visitor,
#    because the route sets reply-to to their address.
#
# Mail is delivered to the address in lib/site.ts (ejioforkelvin@gmail.com).

RESEND_API_KEY=
CONTACT_FROM_EMAIL=


# --- Google Search Console (optional) --------------------------------------
# Add the property, pick the "HTML tag" method, paste the token here, redeploy,
# then click Verify in Search Console.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
